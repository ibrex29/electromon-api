generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CampaignRole {
  CANDIDATE
  CAMPAIGN_DIRECTOR
  STATE_COORDINATOR
  LGA_COORDINATOR
  WARD_COORDINATOR
  SUPPORT_GROUP_LEADER
  VOLUNTEER_COORDINATOR
  POLLING_AGENT_COORDINATOR
  DATA_ANALYST
  MEDIA_TEAM
  POLLING_AGENT
  VOLUNTEER
  POLLING_UNIT_OFFICER
  WARD_RA_OFFICER
  LGA_COLLATION_OFFICER
  STATE_COLLATION_OFFICER
  NATIONAL_COLLATION_OFFICER
}

enum ScopeType {
  CAMPAIGN
  STATE
  SENATORIAL_DISTRICT
  LGA
  WARD
  POLLING_UNIT
  NATIONAL
}

enum CollationLevel {
  POLLING_UNIT
  WARD
  LGA
  STATE
  NATIONAL
}

enum CollationResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CollationActionType {
  SUBMITTED
  APPROVED
  REJECTED
}

enum SupportGroupCategory {
  YOUTH
  WOMEN
  FARMERS
  PROFESSIONALS
  STUDENTS
  RELIGIOUS
  COMMUNITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  ACTIVE
  REJECTED
}

enum FieldReportType {
  SECURITY_CONCERN
  COMMUNITY_REQUEST
  OPPOSITION_ACTIVITY
  CAMPAIGN_PROGRESS
  DAILY_SITREP
  INCIDENT
}

enum IncidentType {
  VOTER_INTIMIDATION
  BALLOT_SNATCHING
  BALLOT_STUFFING
  VOTE_BUYING
  VIOLENCE_THUGGERY
  MATERIALS_SHORTAGE
  LATE_OR_FAILED_OPENING
  BVAS_MALFUNCTION
  UNAUTHORIZED_PERSONNEL
  OVERVOTING
  OPPOSITION_DISRUPTION
  OTHERS
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FieldReportStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum PollingUnitStrength {
  STRONG
  SWING
  WEAK
}

enum PollingUnitStatus {
  ACTIVE
  INACTIVE
  NEEDS_ATTENTION
}

enum SituationStatus {
  OPEN
  REPORTING
  CLOSED
  INCIDENT
}

enum CommitmentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VolunteerTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  RESULT_SUBMITTED
  RESULT_APPROVED
  RESULT_RETURNED
  WARD_RETURNED_BY_LGA
  WARD_FORWARDED_TO_LGA
  INCIDENT_REPORTED
  INCIDENT_RESOLVED
  INCIDENT_ESCALATED
  SITUATION_UPDATE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum DevicePlatform {
  ANDROID
  IOS
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  phoneNumber  String? @unique
  passwordHash String
  firstName    String
  lastName     String
  otherNames   String?
  isActive     Boolean @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  memberships              CampaignMembership[]
  activityLogs             ActivityLog[]
  refreshTokens            RefreshToken[]
  fieldReports             FieldReport[] @relation("FieldReportReporter")
  fieldReportsHandled      FieldReport[] @relation("FieldReportHandler")
  situationUpdates         SituationUpdate[]
  collationResultsSubmitted CollationResult[] @relation("CollationSubmitted")
  collationResultsApproved  CollationResult[] @relation("CollationApproved")
  collationActions          CollationActionLog[] @relation("CollationActionActor")
  deviceTokens              DeviceToken[]
  notificationsReceived     Notification[] @relation("NotificationRecipient")
  notificationsActed        Notification[] @relation("NotificationActor")

  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  campaignId String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([campaignId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Campaign ────────────────────────────────────────────────────────────────

model Campaign {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  stateId          String
  clientPartyCode  String?
  trackedParties   Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  state          State                @relation(fields: [stateId], references: [id])
  memberships    CampaignMembership[]
  supportGroups  SupportGroup[]
  commitments    Commitment[]
  volunteers     Volunteer[]
  fieldReports     FieldReport[]
  activityLogs     ActivityLog[]
  collationResults CollationResult[]
  collationActions CollationActionLog[]
  notifications    Notification[]

  @@index([stateId])
  @@map("campaigns")
}

model CampaignMembership {
  id         String       @id @default(cuid())
  userId     String
  campaignId String
  role       CampaignRole
  scopeType  ScopeType?
  scopeId    String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
  @@index([role])
  @@map("campaign_memberships")
}

model CampaignInvitation {
  id         String       @id @default(cuid())
  email      String
  campaignId String
  role       CampaignRole
  scopeType  ScopeType?
  scopeId    String?
  token      String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([token])
  @@index([email])
  @@map("campaign_invitations")
}

// ─── Geographic Hierarchy ────────────────────────────────────────────────────

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senatorialDistricts SenatorialDistrict[]
  lgas                LGA[]
  campaigns           Campaign[]

  @@map("states")
}

model SenatorialDistrict {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  lgas  LGA[]

  @@unique([name, stateId])
  @@index([stateId])
  @@map("senatorial_districts")
}

model LGA {
  id                   String   @id @default(cuid())
  name                 String
  stateId              String
  senatorialDistrictId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  state              State               @relation(fields: [stateId], references: [id], onDelete: Cascade)
  senatorialDistrict SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  wards              Ward[]
  supportGroups      SupportGroup[]

  @@unique([name, stateId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@map("lgas")
}

model Ward {
  id                   String   @id @default(cuid())
  name                 String
  registrationAreaCode String?
  lgaId                String
  latitude             Float?
  longitude            Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lga          LGA           @relation(fields: [lgaId], references: [id], onDelete: Cascade)
  pollingUnits PollingUnit[]
  volunteers   Volunteer[]
  fieldReports FieldReport[]

  @@unique([name, lgaId])
  @@index([lgaId])
  @@map("wards")
}

model PollingUnit {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  wardId              String
  latitude            Float?
  longitude           Float?
  strengthAssessment  PollingUnitStrength?
  status              PollingUnitStatus   @default(ACTIVE)
  assignedAgentId     String?
  historicalResults   Json?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  ward             Ward              @relation(fields: [wardId], references: [id], onDelete: Cascade)
  fieldReports     FieldReport[]
  situationUpdates SituationUpdate[]

  @@index([wardId])
  @@index([status])
  @@map("polling_units")
}

// ─── Support Groups ──────────────────────────────────────────────────────────

model SupportGroup {
  id                 String               @id @default(cuid())
  campaignId         String
  name               String
  category           SupportGroupCategory
  leaderName         String
  leaderPhone        String
  leaderEmail        String?
  memberCount        Int                  @default(0)
  lgaId              String?
  areaOfOperation    String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus   @default(PENDING)
  coordinatorId      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lga         LGA?         @relation(fields: [lgaId], references: [id])
  commitments Commitment[]

  @@index([campaignId])
  @@index([category])
  @@index([verificationStatus])
  @@map("support_groups")
}

// ─── Commitments ─────────────────────────────────────────────────────────────

model Commitment {
  id             String           @id @default(cuid())
  campaignId     String
  supportGroupId String
  title          String
  description    String?
  targetValue    Int
  currentValue   Int              @default(0)
  deadline       DateTime
  status         CommitmentStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supportGroup SupportGroup          @relation(fields: [supportGroupId], references: [id], onDelete: Cascade)
  progress     CommitmentProgress[]

  @@index([campaignId])
  @@index([supportGroupId])
  @@map("commitments")
}

model CommitmentProgress {
  id           String   @id @default(cuid())
  commitmentId String
  value        Int
  notes        String?
  evidenceUrl  String?
  approved     Boolean  @default(false)
  submittedBy  String
  createdAt    DateTime @default(now())

  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([commitmentId])
  @@map("commitment_progress")
}

// ─── Volunteers ──────────────────────────────────────────────────────────────

model Volunteer {
  id               String   @id @default(cuid())
  campaignId       String
  firstName        String
  lastName         String
  phoneNumber      String
  email            String?
  wardId           String?
  role             String?
  coordinatorId    String?
  performanceScore Float    @default(0)
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ward        Ward?               @relation(fields: [wardId], references: [id])
  assignments VolunteerAssignment[]
  tasks       VolunteerTask[]

  @@index([campaignId])
  @@index([wardId])
  @@map("volunteers")
}

model VolunteerAssignment {
  id          String   @id @default(cuid())
  volunteerId String
  wardId      String?
  role        String
  assignedAt  DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@map("volunteer_assignments")
}

model VolunteerTask {
  id          String              @id @default(cuid())
  volunteerId String
  title       String
  description String?
  status      VolunteerTaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([status])
  @@map("volunteer_tasks")
}

// ─── Field Reporting ─────────────────────────────────────────────────────────

model FieldReport {
  id            String            @id @default(cuid())
  campaignId    String
  reportedById  String
  type             FieldReportType
  incidentType     IncidentType?
  incidentSeverity IncidentSeverity?
  title            String
  description   String
  wardId        String?
  pollingUnitId String?
  latitude      Float?
  longitude     Float?
  photoUrls     String[]
  isUrgent      Boolean           @default(false)
  status        FieldReportStatus @default(OPEN)
  wardComment   String?
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reporter    User         @relation("FieldReportReporter", fields: [reportedById], references: [id])
  handledBy   User?        @relation("FieldReportHandler", fields: [handledById], references: [id])
  ward        Ward?        @relation(fields: [wardId], references: [id])
  pollingUnit PollingUnit? @relation(fields: [pollingUnitId], references: [id])

  @@index([campaignId])
  @@index([type])
  @@index([incidentType])
  @@index([incidentSeverity])
  @@index([status])
  @@index([wardId])
  @@index([createdAt])
  @@map("field_reports")
}

// ─── Election Day ────────────────────────────────────────────────────────────

model SituationUpdate {
  id            String          @id @default(cuid())
  pollingUnitId String
  reportedById  String
  status        SituationStatus
  notes         String?
  latitude      Float?
  longitude     Float?
  isUrgent      Boolean         @default(false)
  createdAt     DateTime        @default(now())

  pollingUnit PollingUnit @relation(fields: [pollingUnitId], references: [id], onDelete: Cascade)
  reporter    User        @relation(fields: [reportedById], references: [id])

  @@index([pollingUnitId])
  @@index([status])
  @@index([createdAt])
  @@map("situation_updates")
}

// ─── Collation & Results ─────────────────────────────────────────────────────

model CollationResult {
  id               String                @id @default(cuid())
  campaignId       String
  level            CollationLevel
  scopeType        ScopeType
  scopeId          String
  registeredVoters Int?
  accreditedVoters Int?
  votesCast        Int?
  invalidVotes     Int?
  partyResults     Json?
  ec8aPhotoUrls    String[]              @default([])
  approvalComment  String?
  status           CollationResultStatus @default(DRAFT)
  submittedById    String?
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  /// When LGA returns a ward, optional PU ids the LGA flagged for ward follow-up
  flaggedPollingUnitIds String[] @default([])
  parentResultId   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("CollationSubmitted", fields: [submittedById], references: [id])
  approvedBy  User?             @relation("CollationApproved", fields: [approvedById], references: [id])
  parent      CollationResult?  @relation("CollationChain", fields: [parentResultId], references: [id])
  children    CollationResult[] @relation("CollationChain")
  actionLogs  CollationActionLog[]

  @@unique([campaignId, level, scopeType, scopeId])
  @@index([campaignId, level, status])
  @@index([scopeType, scopeId])
  @@index([parentResultId])
  @@map("collation_results")
}

/// Append-only audit trail for collation approve / reject / submit events.
model CollationActionLog {
  id                String              @id @default(cuid())
  campaignId        String
  collationResultId String
  action            CollationActionType
  actorId           String
  fromStatus        CollationResultStatus?
  toStatus          CollationResultStatus
  comment           String?
  metadata          Json?
  createdAt         DateTime            @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collationResult CollationResult @relation(fields: [collationResultId], references: [id], onDelete: Cascade)
  actor           User            @relation("CollationActionActor", fields: [actorId], references: [id])

  @@index([collationResultId, createdAt])
  @@index([campaignId, createdAt])
  @@index([actorId])
  @@map("collation_action_logs")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  campaignId String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

model Notification {
  id              String               @id @default(cuid())
  campaignId      String
  recipientUserId String
  actorUserId     String?
  type            NotificationType
  priority        NotificationPriority @default(NORMAL)
  title           String
  body            String
  entityType      String
  entityId        String
  sourceEventId   String
  data            Json
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([campaignId, type, entityId, recipientUserId, sourceEventId], map: "notifications_dedupe_key")
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([campaignId, createdAt])
  @@map("notifications")
}
