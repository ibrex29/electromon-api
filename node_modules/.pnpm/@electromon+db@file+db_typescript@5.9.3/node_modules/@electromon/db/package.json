{
  "name": "@electromon/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && rm -rf dist/generated && cp -R src/generated dist/generated",
    "prebuild": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx --env-file=.env --env-file=../.env prisma/seed.ts",
    "seed:production:apc": "tsx --env-file=.env --env-file=../.env prisma/seed-production-apc.ts",
    "fetch:inec:jigawa": "tsx prisma/scripts/fetch-jigawa-inec.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.11",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "prisma": "^7.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
