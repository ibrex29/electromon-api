# Paste into Dokploy → Environment (not committed).
# DATABASE_URL / RABBITMQ_DEFAULT_PASS / MINIO_ROOT_* must be set — compose
# injects this file with env_file and does not interpolate secrets.

NODE_ENV=production
COMPOSE_PROJECT_NAME=electromon-production

POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=electromon
DATABASE_URL=postgresql://electromon:CHANGE_ME@postgres:5432/electromon?schema=public

REDIS_URL=redis://redis:6379

RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=electromon
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://electromon:CHANGE_ME@rabbitmq:5672

S3_ACCESS_KEY=electromon
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=electromon
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=electromon
MINIO_ROOT_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

METRICS_TOKEN=CHANGE_ME
API_PORT=3002
API_PUBLIC_URL=https://api.electromon.ng
CORS_ORIGIN=https://app.electromon.ng
LOG_LEVEL=info
RUN_SEED=false

# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=
# FCM_DRY_RUN=true

# Google Cloud Vision — EC8A photo OCR
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_VISION_CREDENTIALS=
